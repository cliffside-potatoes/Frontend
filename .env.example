# 프론트 웹 주소 (개발/운영 각각 다르게)
VITE_WEB_ORIGIN=http://localhost:5173

# 백엔드 API 베이스 (프론트 빌드에 박힘)
#
# 로컬 개발(npm run dev): Vite 프록시를 쓰려면 반드시 상대 경로 /api 로 두세요.
# (localhost에서 https://백엔드도메인/api 로 직접 POST 하면 /oauth/token 이 403·CORS에 자주 걸립니다.)
# + vite.config.js 의 VITE_DEV_PROXY_TARGET 에 실제 백엔드 오리진(예: https://test.naeng-gu.kr)
#
# 운영 빌드: 같은 출처 리버스 프록시면 /api, 별도 API 도메인이면 https://api.example.com/api
VITE_API_URL=/api

# 카카오 로그인 시작 (백엔드가 제공하는 시작 URL)
# 예: /login
VITE_KAKAO_LOGIN_START_PATH=/login

# 백엔드가 카카오 로그인 완료 후 302로 보내는 "프론트 콜백 경로"
# 예: /oauth/callback/kakao  (프론트 라우터에 존재해야 함)
VITE_OAUTH_CALLBACK_PATH=/oauth/callback/kakao

# refreshToken 쿠키 기반으로 accessToken 재발급 받는 엔드포인트
# 예: /oauth/token (POST)
VITE_TOKEN_REFRESH_PATH=/oauth/token

# (선택) 로그아웃 엔드포인트가 있으면
VITE_LOGOUT_PATH=/logout