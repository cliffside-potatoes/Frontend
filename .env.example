# 프론트 웹 주소 (개발/운영 각각 다르게)
VITE_WEB_ORIGIN=http://localhost:5173

# 백엔드 API 주소 (개발/운영 각각 다르게)
VITE_API_URL=https://test.naeng-gu.kr/api

# 카카오 로그인 시작 (백엔드가 제공하는 시작 URL)
# 예: /login
VITE_KAKAO_LOGIN_START_PATH=/login

# 백엔드가 카카오 로그인 완료 후 302로 보내는 "프론트 콜백 경로"
# 예: /oauth/callback/kakao  (프론트 라우터에 존재해야 함)
VITE_OAUTH_CALLBACK_PATH=/oauth/callback/kakao

# refreshToken 쿠키 기반으로 accessToken 재발급 받는 엔드포인트
# 예: /oauth/token (POST)
VITE_TOKEN_REFRESH_PATH=/oauth/token

# (선택) 로그아웃 엔드포인트가 있으면
VITE_LOGOUT_PATH=/logout